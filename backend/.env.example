# AquaSense AI - Environment Configuration Example

# Project info
PROJECT_NAME="Intelligent Water Quality Monitoring and Contamination Analysis System"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
SECRET_KEY="aquasense_super_secret_jwt_key_change_in_production_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL default (or fallback to sqlite:///./aquasense.db for standalone quickstart)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquasense_db"
# Fallback SQLite DB URL if Postgres is unavailable:
SQLITE_DB_URL="sqlite:///./aquasense.db"
USE_SQLITE_FALLBACK=True

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage directories
UPLOAD_DIR="./uploads"
REPORT_DIR="./generated_reports"
MODEL_DIR="./trained_models"

# Initial Admin Seed Credentials
ADMIN_EMAIL="admin@aquasense.org"
ADMIN_PASSWORD="AdminPassword123!"
DEMO_USER_EMAIL="user@aquasense.org"
DEMO_USER_PASSWORD="UserPassword123!"
